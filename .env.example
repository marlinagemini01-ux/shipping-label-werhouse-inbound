# Ambil ID dari URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SPREADSHEET_ID=
# Google Cloud Service Account dengan akses Viewer ke spreadsheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM key: salin apa adanya dengan escaped newlines (\\n) atau gunakan secret multiline di Vercel.
GOOGLE_PRIVATE_KEY=""
# Khusus pengembangan lokal: true untuk mencoba UI dengan data DEMO.
# Mode demo ditolak pada NODE_ENV=production.
ENABLE_DEMO_DATA=false
